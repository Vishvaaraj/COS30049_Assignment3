# Copy this file to .env and adjust values.

# FastAPI backend URL — local dev or the deployed Render/Railway URL
VITE_API_BASE_URL=http://localhost:8000

# While Nigel's backend isn't ready, keep this "true" to run the UI on
# mock data shaped like the real API. Flip to "false" once /predict,
# /model-stats, /dataset-stats and /alerts are live.
VITE_USE_MOCK=true
